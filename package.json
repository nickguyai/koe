{
  "name": "koe",
  "version": "1.0.1",
  "description": "Voice transcription with global hotkey support",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && tsc --project ../eval/tsconfig.json --noEmit",
    "start": "npm run build && electron .",
    "dev": "tsc && electron .",
    "test": "vitest run",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "release": "./scripts/release.sh"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/ws": "^8.5.10",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "audiotee": "^0.0.7",
    "electron-store": "^8.1.0",
    "keyspy": "^1.1.1",
    "openai": "^4.102.0",
    "ws": "^8.18.3"
  },
  "build": {
    "appId": "com.koe.app",
    "productName": "Koe",
    "icon": "assets/icon.icns",
    "files": [
      "dist/**/*",
      "assets/**/*"
    ],
    "mac": {
      "notarize": false,
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.icns",
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "hardenedRuntime": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Koe needs microphone access for voice transcription.",
        "NSAccessibilityUsageDescription": "Koe needs accessibility access to insert transcribed text at your cursor.",
        "NSAudioCaptureUsageDescription": "Koe needs system audio recording access to capture remote meeting participants for transcription."
      }
    },
    "extraResources": [
      {
        "from": "bin/",
        "to": "bin/",
        "filter": [
          "ffmpeg",
          "ffprobe"
        ]
      },
      {
        "from": "node_modules/audiotee/bin/",
        "to": "bin/",
        "filter": [
          "audiotee"
        ]
      }
    ]
  }
}
